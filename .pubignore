# pub uses this file instead of .gitignore, so it repeats those rules.
.dart_tool/
.packages
build/
pubspec.lock
doc/api/
.env*
*.dart.js
*.info.json
*.js
*.js_
*.js.deps
*.js.map
.flutter-plugins
.flutter-plugins-dependencies
.idea/
Claude outputs/

# The README links to the demo GIFs on GitHub. Only the mobile one ships in
# the package, because pub.dev shows it as the package screenshot (see
# `screenshots` in pubspec.yaml).
screenshots/*
!screenshots/demo_mobile.gif

# Local planning notes
docs/

# Example platform folders are generated locally with `flutter create .`
example/android/
example/ios/
example/linux/
example/macos/
example/web/
example/windows/
example/.metadata
